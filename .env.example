# Server-side URL of the API gateway (used by Next.js server code)
API_URL=http://localhost:8000
# Browser-side URL of the same gateway (images, uploads, live chat, live updates)
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000
# Public URL of this website (share buttons, Open Graph, social-login callback)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SHOP_NAME=SkyShop
